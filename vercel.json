{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/tracker/:orderId", "destination": "/tracker.html" },
    { "source": "/pay/:invoiceId", "destination": "/pay.html" },
    { "source": "/receipt/:invoiceId", "destination": "/receipt.html" },
    { "source": "/calculator", "destination": "/calculator.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
