# Server Configuration
# Comma-separated allowlist of your site origins, e.g. https://lawncraft.vercel.app
CORS_ORIGIN=
# Public https URL of the site; used in SMS links (tracker / receipt).
PUBLIC_SITE_URL=https://lawncraft.vercel.app
ENFORCE_HTTPS=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
ALLOW_IN_MEMORY_FALLBACK=false

# PostgreSQL Database (Primary Production Database)
# e.g., postgresql://username:password@hostname:5432/lawncraft?sslmode=require
DATABASE_URL=

# Supabase Integration (Alternative / Auth & Storage)
# e.g., https://xyzcompany.supabase.co
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# M-Pesa Daraja (Lipa Na M-Pesa Online / STK Push)
# environment: 'sandbox' (default, for testing) or 'production'
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# PayBill/Till shortcode (6 digits), e.g. 174379
MPESA_SHORTCODE=
# Daraja passkey from the M-Pesa Online service you created in the Daraja dashboard
MPESA_PASSKEY=
# Public HTTPS URL of this server's callback handler, e.g.
# https://lawncraft.vercel.app/api/mpesa/callback
MPESA_CALLBACK_URL=
# REQUIRED in production. Random secret appended to the callback URL as /:token;
# Safaricom only hits the exact URL you configured, so this proves a callback
# is genuine. Without it, payments are disabled when NODE_ENV=production.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MPESA_CALLBACK_TOKEN=
# Abuse limits (database-backed, so they hold on serverless too)
# Max STK prompts per phone number per window.
STK_MAX_PER_PHONE=5
STK_PHONE_WINDOW_MS=900000
# A second prompt for the same invoice within this window returns the pending checkout instead.
STK_DUPLICATE_WINDOW_MS=90000
# Upper bound per transaction (Safaricom caps STK at KSh 250,000).
MPESA_MAX_AMOUNT=250000
# When a payment is still pending after this long, the status endpoint asks
# Daraja directly (recovers lost callbacks without waiting for the cron).
MPESA_STATUS_QUERY_AFTER_MS=20000
# CustomerPayBillOnline (default) or CustomerBuyGoodsOnline
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Max 12 chars; shown on the customer handset. Defaults to LAWNCRAFT.
MPESA_ACCOUNT_REFERENCE=LAWNCRAFT
# Optional override (mostly for tests/local Daraja mirrors)
MPESA_BASE_URL=
# Optional HTTP timeout in ms for Daraja calls (default 20000)
MPESA_HTTP_TIMEOUT_MS=20000

# Admin diagnostics: required in production before /api/system/status responds
ADMIN_API_TOKEN=
# Vercel Cron secret: sent as "Authorization: Bearer $CRON_SECRET" to
# /api/mpesa/reconcile. Required when you enable the cron in vercel.json.
CRON_SECRET=

# Payment reconciliation (lost-callback safety net)
# How old a pending payment must be before a reconciliation run queries Daraja.
RECONCILE_GRACE_MS=900000
# How often the long-running process reconciles pending payments (local/Docker).
RECONCILE_INTERVAL_MS=900000
# Delay before the first background reconciliation after server start.
RECONCILE_INITIAL_DELAY_MS=60000
# Max pending payments checked per run and the time budget per run (keeps a
# serverless invocation inside its execution limit).
RECONCILE_BATCH_LIMIT=25
RECONCILE_TIME_BUDGET_MS=40000

# Company KRA PIN shown on official tax receipts (e.g. P051239841K)
COMPANY_KRA_PIN=

# Outbound notifications (all optional — leave blank to disable)
# Email: owner alerts for new leads/quotes/orders. Uses Resend.
RESEND_API_KEY=
# Verified sender address, e.g. Lawn Craft <orders@lawncraft.com>
NOTIFY_FROM_EMAIL=
# Where lead/quote/order alerts are sent.
OWNER_EMAIL=
# SMS: client confirmations + payment receipts. Uses Africa's Talking.
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_API_KEY=
# Optional sender ID shown on SMS (alphanumeric, e.g. LAWNCRAFT). Unset = default.
AFRICAS_TALKING_SENDER=

# Optional JSON coupon map overriding the built-in defaults, e.g.
# COUPONS_JSON={"SUMMER25":{"type":"percent","value":25}}
COUPONS_JSON=
# Optional JSON overriding the server-side price catalogue (see
# node-backend/config/pricing.js), e.g.
# PRICING_JSON={"minimumOrder":3000,"services":{"Core Aeration":9000}}
PRICING_JSON=